              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Re-populate an existing draft value receipt with current data inline. Returns the slim sync response. Sealed VRs cannot be refreshed."
        },
        {
          "info": {
            "name": "Seal a value receipt",
            "type": "http"
