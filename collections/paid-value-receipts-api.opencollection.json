            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "customerId",
                "value": "",
                "type": "query",
                "description": "Filter by customer display ID."
              },
              {
                "name": "externalCustomerId",
                "value": "",
                "type": "query",
