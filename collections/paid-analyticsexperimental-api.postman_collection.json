        {
          "id": "8436b26d-9c19-427f-bbaa-33859e813426",
          "name": "Discover metadata keys present in your signals (experimental)",
          "request": {
            "name": "Discover metadata keys present in your signals (experimental)",
            "description": {
              "content": "⚠️ **Experimental** — this endpoint may change or be removed without notice and is not subject to v2 backwards-compatibility guarantees. Do not build production-critical integrations against it yet.\n\nLists the JSON paths (and their observed types) present in the `data` payload of your signals within a time window (default: last 30 days), grouped by signal name. Use the returned paths in queries against `fact_signal`, e.g. `WHERE data.<path>::String = '...'`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "experimental",
                "analytics",
                "signals",
                "metadata"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "signalName",
                  "value": "<string>",
                  "description": "Restrict discovery to a single signal name."
                },
                {
                  "disabled": false,
                  "key": "fromDate",
                  "value": "<dateTime>",
                  "description": "Start of the discovery window. Defaults to 30 days ago."
                },
                {
                  "disabled": false,
                  "key": "toDate",
                  "value": "<dateTime>",
                  "description": "End of the discovery window. Defaults to now."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
