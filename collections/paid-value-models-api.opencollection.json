{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference agents value-models API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "value-models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current value model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agentpaid.io/api/v1/value-models/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ]
          },
          "docs": "Returns the current (latest active) value model for the organization."
        },
        {
          "info": {
            "name": "Upload value model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.agentpaid.io/api/v1/value-models/",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Uploads a new value model version. Validates the content, creates a new version, archives the previous active version, syncs to ClickHouse, and triggers a backfill of all historical signals."
        },
        {
          "info": {
            "name": "List version history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agentpaid.io/api/v1/value-models/versions",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all value model versions sorted by version descending. Does not include the full content."
        },
        {
          "info": {
            "name": "Get specific version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.agentpaid.io/api/v1/value-models/versions/:version",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a specific historical value model version by version number, including full content."
        },
        {
          "info": {
            "name": "Trigger backfill",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.agentpaid.io/api/v1/value-models/backfill",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Manually triggers a recalculation of all ClickHouse rows against the current value model."
        }
      ]
    }
  ],
  "bundled": true
}