          },
          "http": {
            "method": "PUT",
            "url": "https://api.agentpaid.io/api/v1/plans/upgrade-path",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates upgrade path ordering for plans within a product, grouped by billing frequency."
        },
        {
          "info": {
            "name": "Get plan",
